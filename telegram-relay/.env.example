PORT=3010
NODE_ENV=production

# Long random secret shared with the main Angel Wings backend.
TELEGRAM_RELAY_SECRET="change-me-to-a-long-random-secret"
TELEGRAM_RELAY_SIGNATURE_TOLERANCE_MS="300000"

# Telegram bot credentials live only on this relay server.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_ORDERS_CHAT_ID=""

# Optional: topic id for forum/supergroup topics.
TELEGRAM_ORDERS_THREAD_ID=""

# SMTP is used from this foreign relay when the main server cannot reach mail ports.
EMAIL_RELAY_SECRET=""
SMTP_HOST="mail.hosting.reg.ru"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_REQUIRE_TLS="false"
SMTP_USER="info@angel-wings.ru"
SMTP_PASSWORD=""
SMTP_FROM="info@angel-wings.ru"
