# Separate virtual host for the Mini App. Replace root, certificate paths and
# backend port with the values used on the production server.
server {
    listen 80;
    server_name app.angel-wings.ru;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name app.angel-wings.ru;

    ssl_certificate /etc/letsencrypt/live/app.angel-wings.ru/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/app.angel-wings.ru/privkey.pem;

    root /srv/angel-wings/telegram-mini-app/dist;
    index index.html;

    location ^~ /api/ {
        proxy_pass http://127.0.0.1:3005;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location ^~ /uploads/ {
        proxy_pass http://127.0.0.1:3005;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location ^~ /assets/ {
        try_files $uri =404;
        expires 1y;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
    }

    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache, must-revalidate" always;
    }
}
