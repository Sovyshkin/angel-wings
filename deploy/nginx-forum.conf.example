# Этап 2: добавьте этот server в /etc/nginx/sites-available/default ПОСЛЕ
# certbot certonly --webroot -w /var/www/angel-wings/forum-app/dist -d forum.angel-wings.ru.
# HTTP-блок из nginx-forum-http.conf.example оставьте для продления сертификата.
server {
    listen 443 ssl http2;
    server_name forum.angel-wings.ru;

    ssl_certificate /etc/letsencrypt/live/forum.angel-wings.ru/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/forum.angel-wings.ru/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;

    client_max_body_size 50m;
    root /var/www/angel-wings/forum-app/dist;
    index index.html;

    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_comp_level 6;
    gzip_types
        application/javascript
        application/json
        application/xml
        application/manifest+json
        image/svg+xml
        text/css
        text/javascript
        text/plain;

    location /api/ {
        proxy_pass http://127.0.0.1:3005;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location ^~ /uploads/ {
        proxy_pass http://127.0.0.1:3005;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        add_header Cache-Control "public, max-age=2592000, immutable" always;
        access_log off;
    }

    location ^~ /assets/ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        access_log off;
    }

    location = /index.html {
        try_files $uri =404;
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
        add_header Pragma "no-cache" always;
        add_header Expires "0" always;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
