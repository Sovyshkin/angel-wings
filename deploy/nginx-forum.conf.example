# Replace the server_name and certificate paths if your chosen subdomain differs.
# Build forum-app first; place its dist at /var/www/angel-wings/forum-app/dist.
server {
    listen 80;
    server_name forum.angel-wings.ru;
    location ^~ /.well-known/acme-challenge/ { root /var/www/angel-wings/forum-app/dist; try_files $uri =404; }
    location / { return 301 https://$host$request_uri; }
}
server {
    listen 443 ssl http2;
    server_name forum.angel-wings.ru;
    ssl_certificate /etc/letsencrypt/live/forum.angel-wings.ru/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/forum.angel-wings.ru/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    root /var/www/angel-wings/forum-app/dist;
    index index.html;
    client_max_body_size 50m;
    location /api/ {
        proxy_pass http://127.0.0.1:3005;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
    location ^~ /uploads/ {
        proxy_pass http://127.0.0.1:3005;
        proxy_set_header Host $host;
    }
    location / { try_files $uri $uri/ /index.html; }
}
