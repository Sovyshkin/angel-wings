DATABASE_URL="file:./dev.db"
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
MARKETING_TOKEN_SECRET="your-marketing-link-encryption-secret-change-in-production"
PORT=3000
NODE_ENV=development
UPLOAD_DIR=uploads

# Tochka Bank Acquiring (оплата)
TOCHKA_JWT_TOKEN="your_jwt_token_here"
TOCHKA_CUSTOMER_CODE="your_customer_code"
TOCHKA_CLIENT_ID="your_client_id"
TOCHKA_REDIRECT_BASE_URL="https://your-domain.com"
TOCHKA_TAX_SYSTEM_CODE="usn_income"
# Optional: set only to a value supported by the current Tochka OpenAPI schema.
TOCHKA_VAT_TYPE=""

# Tinkoff (deprecated)
# TINKOFF_TERMINAL_KEY="your-test-terminal-key"
# TINKOFF_SECRET_KEY="your-test-secret-key"
# TINKOFF_TEST_MODE="true"
# TINKOFF_API_URL="https://rest-api-stage.tinkoff.ru"
API_URL="http://localhost:3000"
CLIENT_URL="http://localhost:5173"
EMAIL_CODE_TTL_MINUTES="15"
PASSWORD_RESET_TTL_MINUTES="30"

# Email delivery
# auto = direct SMTP first, relay only if SMTP is not configured. Use smtp to force direct sending.
EMAIL_DELIVERY_MODE="smtp"
SMTP_HOST="mail.hosting.reg.ru"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_REQUIRE_TLS="false"
SMTP_USER="info@angel-wings.ru"
SMTP_PASSWORD="your-mailbox-password"
SMTP_FROM="info@angel-wings.ru"
SMTP_CONNECTION_TIMEOUT_MS="8000"
SMTP_GREETING_TIMEOUT_MS="8000"
SMTP_SOCKET_TIMEOUT_MS="15000"
# Optional fallback relay. Leave empty when email should be sent from the main server.
EMAIL_RELAY_URL=""
EMAIL_RELAY_SECRET=""
EMAIL_RELAY_TIMEOUT_MS="20000"

# CDEK Delivery API
CDEK_ACCOUNT="your-cdek-account"
CDEK_PASSWORD="your-cdek-password"
CDEK_URL="https://api.cdek.ru/v2"
CDEK_TOKEN_URL="https://api.cdek.ru/v2/oauth/token"
CDEK_ENABLE_RECIPIENT_SMS="true"
# Comma-separated CDEK additional service codes for recipient notifications.
# If your CDEK manager gives a different code, change it here without code edits.
CDEK_SMS_SERVICE_CODES="SMS"

# Yandex Geocoder for Moscow courier address validation
YANDEX_GEOCODER_API_KEY=""
YANDEX_GEOCODER_TIMEOUT_MS="10000"

# Telegram notifications for internal Moscow courier orders
# If TELEGRAM_RELAY_URL is set, the main server sends notifications to a separate relay backend.
TELEGRAM_RELAY_URL=""
# Shared HMAC secret for signing requests to telegram-relay.
TELEGRAM_RELAY_SECRET=""
TELEGRAM_RELAY_TIMEOUT_MS="30000"

# Direct Telegram mode (used only when TELEGRAM_RELAY_URL is empty)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_ORDERS_CHAT_ID=""
# Optional: topic id for forum chats
TELEGRAM_ORDERS_THREAD_ID=""
