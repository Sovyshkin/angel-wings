{
  "name": "peptidi-server",
  "version": "1.0.0",
  "description": "Backend API for Angel Wings",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "dev": "nodemon src/index.js",
    "start": "node src/index.js",
    "worker:recovery": "node src/recovery-worker.js",
    "worker:telegram": "node src/telegram-worker.js",
    "cdek:recover": "node scripts/recover-cdek-orders.mjs",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:recovery-worker": "node scripts/apply-recovery-worker-schema.mjs",
    "db:telegram-queue": "node scripts/apply-telegram-queue-schema.mjs",
    "db:payment-type": "node scripts/apply-payment-type-schema.mjs",
    "db:acquiring-settings": "node scripts/apply-acquiring-settings-schema.mjs",
    "db:order-edit": "node scripts/apply-order-edit-schema.mjs",
    "db:dosage-stock": "node scripts/apply-dosage-stock-schema.mjs",
    "db:manual-order-origin": "node scripts/apply-manual-order-origin-schema.mjs",
    "db:recommendations": "node scripts/apply-product-recommendations-schema.mjs",
    "db:favorite-pickups": "node scripts/apply-favorite-pickup-points-schema.mjs",
    "db:personal-promos": "node scripts/apply-personal-promos-schema.mjs",
    "db:blog": "node scripts/apply-blog-schema.mjs",
    "db:roles": "node scripts/apply-admin-roles-schema.mjs",
    "db:blog-drafts": "node scripts/seed-blog-drafts.mjs",
    "telegram:enqueue": "node scripts/enqueue-telegram-order.mjs",
    "points:campaign-preview": "node scripts/preview-points-campaign.mjs",
    "db:seed": "node prisma/seed.js",
    "admin:set-email": "node scripts/change-admin-email.mjs",
    "import:products": "node import-products.js",
    "test:smoke": "node scripts/smoke-test.mjs",
    "test:smoke:prod": "SMOKE_BASE_URL=https://angel-wings.ru node scripts/smoke-test.mjs"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "axios": "^1.16.1",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "docx": "^9.12.0",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.18.3",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.10.1",
    "pdfkit": "^0.20.2",
    "sanitize-html": "2.16.0",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.0",
    "prisma": "^5.22.0"
  }
}
