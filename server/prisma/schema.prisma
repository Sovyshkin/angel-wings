generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                          Int                     @id @default(autoincrement())
  email                       String                  @unique
  password                    String
  name                        String
  role                        String                  @default("USER")
  phone                       String?
  address                     String?
  pointsBalance               Int                      @default(0)
  emailVerified               Boolean                 @default(true)
  createdAt                   DateTime                @default(now())
  updatedAt                   DateTime                @updatedAt
  orders                      Order[]
  partner                     Partner?
  partnerUser                 PartnerUser?
  partnerApplications         PartnerApplication[]    @relation("PartnerApplicationUser")
  reviewedPartnerApplications PartnerApplication[]    @relation("PartnerApplicationReviewer")
  productAnalyticsEvents      ProductAnalyticsEvent[]
  emailVerificationCodes      EmailVerificationCode[]
  pointTransactions           UserPointTransaction[]   @relation("UserPointTransactions")
  createdPointTransactions    UserPointTransaction[]   @relation("UserPointTransactionsCreated")

  @@map("users")
}

model EmailVerificationCode {
  id        Int       @id @default(autoincrement())
  userId    Int
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  email     String
  codeHash  String
  purpose   String    @default("email_verification")
  expiresAt DateTime
  usedAt    DateTime?
  attempts  Int       @default(0)
  createdAt DateTime  @default(now())

  @@index([userId, purpose, expiresAt])
  @@index([email, purpose, expiresAt])
  @@map("email_verification_codes")
}

model EmailCampaign {
  id          Int       @id @default(autoincrement())
  subject     String
  body        String
  audience    String    @default("all")
  status      String    @default("PENDING")
  total       Int       @default(0)
  sent        Int       @default(0)
  failed      Int       @default(0)
  errorLog    String?
  createdById Int?
  createdAt   DateTime  @default(now())
  sentAt      DateTime?

  @@map("email_campaigns")
}

model Category {
  id          Int        @id @default(autoincrement())
  name        String
  slug        String     @unique
  description String?
  image       String?
  active      Boolean    @default(true)
  parentId    Int?
  parent      Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryHierarchy")
  products    Product[]  @relation("ProductCategories")
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@map("categories")
}

model Product {
  id              Int                     @id @default(autoincrement())
  title           String
  slug            String                  @unique
  description     String
  price           Float
  comparePrice    Float?
  costPrice       Float                   @default(0)
  sku             String?                 @unique
  stock           Int                     @default(0)
  weight          Int                     @default(0) // Вес в граммах
  packageLength   Int                     @default(0) // Длина упаковки в см
  packageWidth    Int                     @default(0) // Ширина упаковки в см
  packageHeight   Int                     @default(0) // Высота упаковки в см
  repeatCycleDays Int? // Через сколько дней клиенту пора повторить курс
  country         String?
  image           String?
  images          String                  @default("[]")
  specs           String                  @default("{}")
  featured        Boolean                 @default(false)
  active          Boolean                 @default(true)
  categories      Category[]              @relation("ProductCategories")
  orderItems      OrderItem[]
  analyticsEvents ProductAnalyticsEvent[]
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  @@map("products")
}

model Order {
  id                  Int                @id @default(autoincrement())
  clientRequestId     String?            @unique
  userId              Int?
  user                User?              @relation(fields: [userId], references: [id])
  partnerId           Int?
  status              String             @default("PENDING")
  cancelReason        String?
  paymentStatus       String?            @default("PENDING")
  paymentId           String?
  total               Float
  partnerBonusAmount  Float?             @default(0)
  acquiringFee        Float?
  deliveryCost        Float?
  utmSource           String?
  utmMedium           String?
  utmCampaign         String?
  utmContent          String?
  utmTerm             String?
  items               OrderItem[]
  customerName        String
  customerEmail       String
  customerPhone       String
  shippingAddress     String?
  notes               String?
  promoCodeId         Int?
  discountAmount      Float?
  userPointsUsed      Int                @default(0)
  // Delivery info
  deliveryTariffCode  Int?
  deliveryTariffName  String?
  deliveryPrice       Float?
  deliveryCity        String?
  deliveryPickupPoint String?
  deliveryPickupName  String?
  cdekOrderUuid       String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  commission          PartnerCommission?
  pointTransactions   UserPointTransaction[]

  @@map("orders")
}

model OrderItem {
  id        Int     @id @default(autoincrement())
  orderId   Int
  order     Order   @relation(fields: [orderId], references: [id])
  productId Int
  product   Product @relation(fields: [productId], references: [id])
  dosage    String?
  quantity  Int
  price     Float

  @@map("order_items")
}

model ProductAnalyticsEvent {
  id        Int      @id @default(autoincrement())
  productId Int
  product   Product  @relation(fields: [productId], references: [id])
  userId    Int?
  user      User?    @relation(fields: [userId], references: [id])
  event     String
  sessionId String?
  source    String?
  quantity  Int?
  createdAt DateTime @default(now())

  @@index([productId, event, createdAt])
  @@index([sessionId, createdAt])
  @@map("product_analytics_events")
}

model UserPointTransaction {
  id             Int       @id @default(autoincrement())
  userId         Int
  user           User      @relation("UserPointTransactions", fields: [userId], references: [id], onDelete: Cascade)
  amount         Int
  balanceAfter   Int
  type           String
  message        String?
  orderId        Int?
  order          Order?    @relation(fields: [orderId], references: [id], onDelete: SetNull)
  batchId        String?
  createdById    Int?
  createdBy      User?     @relation("UserPointTransactionsCreated", fields: [createdById], references: [id], onDelete: SetNull)
  seenAt         DateTime?
  createdAt      DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([userId, seenAt])
  @@index([batchId])
  @@map("user_point_transactions")
}

model CdekBox {
  id        Int      @id @default(autoincrement())
  code      String   @unique
  length    Int
  width     Int
  height    Int
  maxWeight Int
  price     Float    @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("cdek_boxes")
}

model MarketingEvent {
  id          Int      @id @default(autoincrement())
  title       String
  type        String   @default("campaign")
  channel     String?
  cost        Float    @default(0)
  utmSource   String?
  utmCampaign String?
  description String?
  eventDate   DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([eventDate])
  @@map("marketing_events")
}

model Partner {
  id           Int      @id @default(autoincrement())
  userId       Int      @unique
  user         User     @relation(fields: [userId], references: [id])
  percentage   Float    @default(5.0)
  referralCode String   @unique
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  promoCodes   PromoCode[]
  commissions  PartnerCommission[]
  payments     PartnerPayment[]
  partnerUsers PartnerUser[]
  applications PartnerApplication[]

  @@map("partners")
}

model PartnerApplication {
  id           Int       @id @default(autoincrement())
  name         String
  email        String
  phone        String?
  telegram     String?
  city         String?
  audience     String?
  experience   String?
  message      String?
  status       String    @default("PENDING")
  adminNote    String?
  userId       Int?
  user         User?     @relation("PartnerApplicationUser", fields: [userId], references: [id], onDelete: SetNull)
  partnerId    Int?
  partner      Partner?  @relation(fields: [partnerId], references: [id], onDelete: SetNull)
  reviewedById Int?
  reviewedBy   User?     @relation("PartnerApplicationReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([status, createdAt])
  @@index([email])
  @@map("partner_applications")
}

model PromoCode {
  id              Int           @id @default(autoincrement())
  code            String        @unique
  discountType    String        @default("percentage")
  discountValue   Float
  usageType       String        @default("single")
  maxActivations  Int           @default(1)
  activationCount Int           @default(0)
  startDate       DateTime?
  endDate         DateTime?
  minOrderAmount  Float?
  isFirstPurchase Boolean       @default(false)
  isActive        Boolean       @default(true)
  partnerId       Int?
  partner         Partner?      @relation(fields: [partnerId], references: [id])
  partnerUsers    PartnerUser[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@map("promo_codes")
}

model PartnerUser {
  id             Int        @id @default(autoincrement())
  userId         Int        @unique
  user           User       @relation(fields: [userId], references: [id])
  partnerId      Int
  partner        Partner    @relation(fields: [partnerId], references: [id])
  referralSource String     @default("link")
  promoCodeId    Int?
  promoCode      PromoCode? @relation(fields: [promoCodeId], references: [id])
  boundAt        DateTime   @default(now())

  @@map("partner_users")
}

model PartnerCommission {
  id         Int      @id @default(autoincrement())
  partnerId  Int
  partner    Partner  @relation(fields: [partnerId], references: [id])
  orderId    Int      @unique
  order      Order    @relation(fields: [orderId], references: [id])
  userId     Int
  amount     Float
  percentage Float
  createdAt  DateTime @default(now())

  @@map("partner_commissions")
}

model PartnerPayment {
  id          Int       @id @default(autoincrement())
  partnerId   Int
  partner     Partner   @relation(fields: [partnerId], references: [id])
  amount      Float
  status      String    @default("PENDING")
  type        String    @default("PAYOUT")
  details     String?
  comment     String?
  processedBy Int?
  createdAt   DateTime  @default(now())
  paidAt      DateTime?
  processedAt DateTime?

  @@map("partner_payments")
}

model Dealer {
  id        Int      @id @default(autoincrement())
  city      String
  phone     String?
  address   String?
  telegram  String?
  instagram String?
  max       String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, city])
  @@map("dealers")
}
